# Runtime mode: development, test, staging, or production.
APP_ENV=

# Mandatory outside tests. Use at least 32 random characters; rotating it invalidates sessions.
SECRET_KEY=

# Mandatory in staging and production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI evaluation. OPENAI_API_KEY is mandatory in staging/production when enabled.
AI_EVALUATION_ENABLED=
OPENAI_API_KEY=
EVALUATOR_MODEL=

# Firebase uses Application Default Credentials when this path is blank.
# Prefer workload identity in production; never place a key file in the repository.
FIREBASE_ENABLED=
GOOGLE_APPLICATION_CREDENTIALS=

# Local OAuth HTTP exception. Never enable this in staging or production.
OAUTHLIB_INSECURE_TRANSPORT=

# Session settings. Production requires SESSION_COOKIE_SECURE=true.
SESSION_TYPE=
SESSION_FILE_DIR=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=

# Optional exercise root and ingress limits.
EXERCISES_ROOT=
MAX_CONTENT_LENGTH=
MAX_ANSWER_LENGTH=
MAX_TEACHER_QUESTION_LENGTH=
MAX_FEEDBACK_LENGTH=

# Rate-limit rules and storage. memory:// is local/test only.
RATELIMIT_STORAGE_URI=
LOGIN_RATE_LIMIT=
ANSWER_RATE_LIMIT=
FEEDBACK_RATE_LIMIT=
TEACHER_HELP_RATE_LIMIT=

# External HTTP connection and response-read timeouts in seconds.
HTTP_CONNECT_TIMEOUT=
HTTP_READ_TIMEOUT=
